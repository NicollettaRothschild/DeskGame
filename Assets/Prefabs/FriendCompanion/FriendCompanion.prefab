      onboardingPracticeReminderMaxCount: 2
      onboardingRequirePractice: true
      onboardingPresentDistanceCm: !<float> 22.000000
      onboardingPresentHeightCm: !<float> 0.000000
      onboardingObjectSpacingCm: !<float> 18.000000
      onboardingWelcomeLine: "Hi! I’m your buddy. Let’s set up your space one piece at a time. I’ll show you sticky notes, your pot stack, and a clock."
      onboardingClosingLine: "You're all set! I'll tag along from here. Say hey friend if you want to talk again. When you finish your goal — or walk the distance — I'll congratulate you and your plant will fully grow. Have fun!"
      onboardingClock: !<reference.SceneObject> 0c384a6b-e0e5-473f-9eeb-b74a88ed647f
      onboardingClockLine: Here’s your clock. Put it somewhere easy to check while you work.
      onboardingPalette: !<reference.SceneObject> 9aa42fcc-a72f-4475-a934-1f79675ea728
      onboardingIncludePalette: false
      onboardingPaletteLine: This is your palette. Paint your world with it! Put it somewhere you can reach while you work.
      onboardingPlanter: !<reference.SceneObject> 7c7350dc-41a2-4426-a5bb-047d14525a11
      onboardingPlanterLine: Here’s your pot stack. Each goal pot arrives with a seed already planted. Put the stack somewhere easy to reach.
      onboardingPostIt: !<reference.SceneObject> d7569447-6ffa-4d71-9778-b93af9b8cb95
      onboardingPostItLine: "These are your sticky notes. Pull one out and start speaking, and I’ll write down what you say."
      onboardingTrash: !<reference.SceneObject> f293204d-edc4-4b3a-8a09-4c89c40d6fa2
      onboardingTrashLine: "And here’s the trash. Put it wherever you like, then drop things in when you don’t need them anymore."
      onboardingLeaderboard: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingLeaderboardLine: "And here's your distance leaderboard. Grab it to place it anywhere in your space."
      enableLeaderboardPanel: false
      onboardingGoalPromptLine: "What goal should we grow together? Say something like: I want to walk 20 meters."
      onboardingGoalSeedLine: "There it is! Your goal pot already has a seed planted. Place it where you like; it waters itself and grows as you make progress. Tell me when you finish the goal, and it will fully bloom."
      onboardingGoalListenTimeoutSec: !<float> 22.000000

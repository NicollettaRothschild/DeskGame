      bubbleHeightOffset: !<float> 5.000000
      bubbleForwardOffset: 0.150000
      enableLookAt: false
      lookAtDistanceMeters: 0.200000
      lookAtExitPaddingMeters: 0.050000
      lookAtTurnSpeed: !<float> 6.000000

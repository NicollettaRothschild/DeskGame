      petDialogueLines: !<string[]>
        - "Aww, thank you!"
        - That tickles!
        - "Hehe, I like that!"
        - "You're a good friend."
      enableSpeechBubble: true
      enableTts: true
      enableOnboarding: true
      treatAsNewUser: false

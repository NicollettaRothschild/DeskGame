      onboardingPaletteLine: "Here's the palette. Grab and release to place it where you like."
      onboardingPlanter: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingPlanterLine: "Here's your pot stack. Each goal pot arrives with a seed already planted. Put the stack somewhere easy to reach."
      onboardingPostIt: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingPostItLine: "Here's the sticky notes. Pull one and speak — your words appear on it."
      onboardingTrash: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingTrashLine: "Here's the trash. Drop things into it to clean up."
      onboardingLeaderboard: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingLeaderboardLine: "And here's your distance leaderboard. Grab it to place it anywhere in your space."
      enableLeaderboardPanel: false
      onboardingGoalPromptLine: "What goal should we grow together? Say something like: I want to run one kilometer."
      onboardingGoalSeedLine: "There it is! Your goal pot already has a seed planted. Place it where you like; it waters itself and grows as you make progress. Tell me when you finish the goal, and it will fully bloom!"

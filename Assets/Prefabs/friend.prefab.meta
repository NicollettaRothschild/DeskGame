      onboardingPresentHeightCm: !<float> 0.000000
      onboardingObjectSpacingCm: !<float> 18.000000
      onboardingWelcomeLine: "Hi! I'm your buddy. I'll show you sticky notes, your pot stack, and a clock one by one."
      onboardingClosingLine: "You're all set! Say hey Arvis if you need help. Have fun!"
      onboardingGlobe: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingGlobeLine: "Here's the globe. Pinch to grab it, move it, then release."
      onboardingClock: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingClockLine: "Here's the clock. Grab it, move it, then let go."
      onboardingPalette: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingPaletteLine: "Here's the palette. Grab and release to place it where you like."
      onboardingIncludePalette: false
      onboardingPlanter: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingPlanterLine: "Here's your pot stack. Each goal pot arrives with a seed already planted. Put the stack somewhere easy to reach."
      onboardingPostIt: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingPostItLine: "Here's the sticky notes. Pull one and speak — your words appear on it."
      onboardingTrash: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingTrashLine: "Here's the trash. Drop things into it to clean up."
      onboardingLeaderboard: !<reference.SceneObject> 00000000-0000-0000-0000-000000000000
      onboardingLeaderboardLine: "And here's your distance leaderboard. Grab it to place it anywhere in your space."
      enableLeaderboardPanel: false
      onboardingGoalPromptLine: "What goal should we grow together? Say something like: I want to run one kilometer."
      onboardingGoalSeedLine: "There it is! Your goal pot already has a seed planted. Place it where you like; it waters itself and grows as you make progress. Tell me when you finish the goal, and it will fully bloom!"
      onboardingGoalListenTimeoutSec: !<float> 22.000000
      onboardingGoalFallback: I want to run one kilometer
      onboardingAutoGoalFallbackOnTimeout: false
      onboardingRequireGoalPotPractice: true
      agentTts: !<MappingBased.AssignableType> a1b2c3d4-e5f6-7890-abcd-ef1234567892
      grabSpeechTrack: !<reference.AudioTrackAsset> 00000000-0000-0000-0000-000000000000
      releaseSpeechTrack: !<reference.AudioTrackAsset> 00000000-0000-0000-0000-000000000000
      grabBubbleText: Whee!
      releaseBubbleText: Thanks!
      speechBubbleHideDelaySec: !<float> 4.000000
      bubbleScaleCompensation: !<float> 3.000000
      bubbleHeightOffset: !<float> 5.000000
      bubbleForwardOffset: 0.150000

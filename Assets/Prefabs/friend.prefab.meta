      enableIdleBob: true
      idleBobAmplitudeCm: 1.500000
      idleBobSpeed: 1.800000
      goalCongratsLine: "Woohoo! You did it! I'm so proud of you — your plant is fully grown!"
      enableGoalLeaderboard: true
      goalLeaderboardModule: !<reference.LeaderboardModule> 00000000-0000-0000-0000-000000000000
      goalLeaderboardName: DeskGameGoals
